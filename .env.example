#--------------------------------------------------------------------
# Example Environment Configuration File — Domain App
#
# Copy this file to .env and customize. NEVER commit .env to git.
#
# Command: cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8193'
# app.forceGlobalSecureRequests = false

# IANA timezone for venue wall-clock schedules (technical timestamps stay UTC).
EVENT_SCHEDULE_TIMEZONE = America/Santiago

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = teatromuseo_event_domain
database.default.username = root
database.default.password = YOUR_DATABASE_PASSWORD_HERE
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Test database
database.tests.hostname = 127.0.0.1
database.tests.database = teatromuseo_event_domain_test
database.tests.username = root
database.tests.password = YOUR_DATABASE_PASSWORD_HERE
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = ""
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate with: php spark key:generate
encryption.key = ""

#--------------------------------------------------------------------
# HUB COORDINATES
#
# This domain app delegates auth to the central Teatro Museo API ("hub"). The
# hub validates JWTs (via /auth/introspect) and issues service tokens (via
# /auth/service-token) that this app uses for M2M calls back to the hub.
#--------------------------------------------------------------------

# Base URL of the hub (no trailing slash).
hub.url = 'http://localhost:8180'

# Application code as registered in the hub (one row in the `applications`
# table). Used as the JWT `sub` for service tokens issued to this app.
hub.appCode = 'event'

# X-App-Key header value. Created by `php spark apps:bootstrap <code>` on the
# hub side; the key is bound to a single application_id.
hub.apiKey = ''

# Cache TTL (seconds) for /auth/introspect responses. Lower = revocations
# propagate faster, higher = less load on the hub.
hub.introspectCacheTtl = 60

# Optional superadmin JWT used only by setup commands that explicitly request
# --mirror-to-self or --assign-to-role. Never use this for normal runtime
# traffic, and never commit a real token.
# hub.adminToken = ''

# Shared HMAC secret for authenticated internal callbacks from the hub.
# Leave empty to keep internal callback endpoints fail-closed until the same
# strong secret is configured in the hub and every participating domain.
HUB_INTERNAL_SECRET = ''

# Deprecated dotted compatibility alias. Prefer HUB_INTERNAL_SECRET above.
# hub.internalSecret = ''

# Public web-app key accepted by this domain's public endpoints. Keep empty in
# templates; provision the real value through the deployment secret store.
WEB_API_KEY = ''

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------

CORS_ALLOWED_ORIGINS = 'http://localhost:3000,http://localhost:5173'
CORS_SUPPORTS_CREDENTIALS = false
# Optional overrides. Keep the defaults from Config\Cors unless the deployment
# needs a narrower policy.
# CORS_ALLOWED_METHODS = 'GET,POST,PUT,PATCH,DELETE,OPTIONS'
# CORS_ALLOWED_HEADERS = 'Content-Type,Authorization,X-App-Key,X-Request-Id,Accept,Origin'
# CORS_EXPOSED_HEADERS = 'X-Request-Id,X-RateLimit-Limit,X-RateLimit-Remaining'
# CORS_MAX_AGE = 86400

# Trusted reverse-proxy IPs. Format: comma-separated cidr=header pairs.
# app.proxyIPs = '10.0.0.0/8=X-Forwarded-For'

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------

RATE_LIMIT_REQUESTS = 60
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_USER_REQUESTS = 100
PUBLIC_READ_RATE_LIMIT_REQUESTS = 600
PUBLIC_READ_RATE_LIMIT_WINDOW = 60

#--------------------------------------------------------------------
# QUEUE (used by audit async writes)
#--------------------------------------------------------------------
# Options: 'database', 'redis', 'sync'.
# IMPORTANT: On shared hosting without a persistent queue:work daemon,
# set this to 'sync' so jobs run immediately during the request.
QUEUE_DRIVER = database
QUEUE_DATABASE_CONNECTION = default
QUEUE_MAX_ATTEMPTS = 3
QUEUE_RETRY_AFTER = 90

# Redis settings are used only when QUEUE_DRIVER = redis.
QUEUE_REDIS_HOST = 127.0.0.1
QUEUE_REDIS_PORT = 6379
QUEUE_REDIS_PASSWORD = ''
QUEUE_REDIS_DATABASE = 0

#--------------------------------------------------------------------
# AUDIT
#--------------------------------------------------------------------
# Set to false on shared hosting to disable async audit enqueuing,
# persisting them synchronously to prevent table bloat without workers.
AUDIT_ASYNC_ENABLED = true
# AUDIT_QUEUE_NAME = audit
# AUDIT_MAX_PAYLOAD_BYTES = 60000
# AUDIT_RETENTION_DAYS = 90

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

LOG_LEVEL = debug
LOG_FORMAT = json

#--------------------------------------------------------------------
# MAINTENANCE
#--------------------------------------------------------------------

MAINTENANCE_MODE = false
MAINTENANCE_RETRY_AFTER = 60

#--------------------------------------------------------------------
# LOCALIZATION
#--------------------------------------------------------------------

# Legacy rows without a translation use this locale as their fallback.
# Read by dcardenasl/ci4-api-core's Config\Localization, shared by every domain
# app (replaces the app-specific EVENT_LEGACY_FALLBACK_LOCALE).
LOCALIZATION_LEGACY_FALLBACK_LOCALE = es
