#!/bin/bash
#
# Non-blocking reminder hook. When this checkout is inside the monorepo and
# pushes dev, run the consolidated freshness check as an informational warning.
# Standalone clones remain fully independent and the hook always exits 0.
#
# Installed by composer's post-install-cmd/post-update-cmd, alongside pre-commit.

REPO_LABEL="teatromuseo-event-domain"

pushing_to_dev=false
while read -r local_ref _local_sha remote_ref _remote_sha; do
    if [ "${local_ref}" = "refs/heads/dev" ] || [ "${remote_ref}" = "refs/heads/dev" ]; then
        pushing_to_dev=true
    fi
done

if [ "${pushing_to_dev}" != "true" ]; then
    exit 0
fi

FRESHNESS_SCRIPT="../scripts/check-platform-freshness.sh"
if [ ! -f "${FRESHNESS_SCRIPT}" ]; then
    exit 0
fi

echo "[${REPO_LABEL}] pushing dev — checking monorepo platform freshness (informational only, never blocks)..." >&2
bash "${FRESHNESS_SCRIPT}" >&2 || true

exit 0
